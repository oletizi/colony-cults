  "rounds": 1,
  "liftedFindings": [
    {
      "id": "0c434a1dcbc8d6d4::AUDIT-BARRAGE-claude-01",
      "title": "Snapshot side-effect fires BEFORE the atomic claim, so an EEXIST retry can overwrite the winner's metadata snapshot",
      "severity": "high"
    },
    {
      "id": "0c96c6263ff2d5cb::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "The corpus seam is only half-wired: acquire / reconcile / verify-member / promote self-compose a committed-corpus policy instead of receiving the injected `CorpusComposition`",
      "severity": "high"
    },
    {
      "id": "0c96c6263ff2d5cb::AUDIT-BARRAGE-claude-02",
      "title": "`selectedCopyHasRecordedAssets` converts a new config-driven throw into a silent reconcile misroute",
      "severity": "high"
    },
    {
      "id": "190ff594c244b066::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-claude-06+AUDIT-BARRAGE-codex-01+AUDIT-BARRAGE-codex-02",
      "title": "Next-ID prediction reads declared `sourceId`s while the allocator reads filenames — a real collision passes validation silently",
      "severity": "high"
    },
    {
      "id": "1c8909a568ed692b::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "Override collision detection only compares override-against-override, so an override aimed at another Source's *generic* location passes validation",
      "severity": "high"
    },
    {
      "id": "266a24c4260b019d::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "`validate()` silently skips the search-log scope check when `validCaseIds` is omitted — a check that used to run unconditionally",
      "severity": "high"
    },
    {
      "id": "266a24c4260b019d::AUDIT-BARRAGE-claude-02",
      "title": "Coverage report unions Sources across all corpora but narrows case ids to the selected corpus — over a *global* search log",
      "severity": "high"
    },
    {
      "id": "33c09f07a76d3032::AUDIT-BARRAGE-claude-01",
      "title": "The coverage page mixes two corpus scopes in one render, and needs a core edit the moment a second corpus lands",
      "severity": "high"
    },
    {
      "id": "33c09f07a76d3032::AUDIT-BARRAGE-claude-02",
      "title": "`committedSourceFilenamePolicy()` is used to justify second-corpus safety, but a \"committed\"/bootstrap policy is exactly what cannot see a second corpus",
      "severity": "high"
    },
    {
      "id": "3594cc339ca7ad69::AUDIT-BARRAGE-claude-01",
      "title": "Browser-profile `defaultSources` are type-checked but never checked against the corpus's own source-id policies — and the new fixtures encode ids no policy can allocate",
      "severity": "high"
    },
    {
      "id": "3596d2799a71be80::AUDIT-BARRAGE-claude-01",
      "title": "The deferred source-filename composition root unions *every* committed corpus, so the moment a second corpus is committed ~half the call sites silently enumerate both corpora's Sources",
      "severity": "high"
    },
    {
      "id": "38124fbd7898f282::AUDIT-BARRAGE-claude-01",
      "title": "`stripComments` desyncs on regex literals — the doc certifies a property the scanner does not have",
      "severity": "high"
    },
    {
      "id": "3963b24beadb348c::AUDIT-BARRAGE-claude-01",
      "title": "The INV-16 silent-empty channel is still open: a policy that matches zero files still enumerates zero Sources with no error",
      "severity": "high"
    },
    {
      "id": "3963b24beadb348c::AUDIT-BARRAGE-claude-02",
      "title": "\"Behavior preservation\" assertion is one-directional; the new two-prefix policy is strictly narrower than the retired pattern and the guard cannot see the narrowing",
      "severity": "high"
    },
    {
      "id": "3963b24beadb348c::AUDIT-BARRAGE-claude-03",
      "title": "The unselected `loadCoverageReport` path silently unions across every corpus, and this diff pins that fallback as expected behavior",
      "severity": "high"
    },
    {
      "id": "42c5848e9761f72a::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "Handlers receive an injected `CorpusComposition` and then discard it in favour of a module-global `committedSourceFilenamePolicy()`",
      "severity": "high"
    },
    {
      "id": "42c5848e9761f72a::AUDIT-BARRAGE-claude-02",
      "title": "`installedCapabilities()` reads a side-effect-populated registry with no guaranteed import, so `bib validate-config` can compute an empty capability set",
      "severity": "high"
    },
    {
      "id": "4bb0a62ae8e0e184::AUDIT-BARRAGE-claude-01",
      "title": "`--corpus` is accepted, validated, and then thrown away by the `translate` bin's handlers",
      "severity": "high"
    },
    {
      "id": "4bb0a62ae8e0e184::AUDIT-BARRAGE-claude-02",
      "title": "`committedSourceFilenamePolicy()` is an ambient global read that bypasses the injected corpora root",
      "severity": "high"
    },
    {
      "id": "4bb0a62ae8e0e184::AUDIT-BARRAGE-claude-03",
      "title": "A browser profile's `corpus` field is never checked against the corpus whose file it is — and the test canonizes the mismatch",
      "severity": "high"
    },
    {
      "id": "4bb0a62ae8e0e184::AUDIT-BARRAGE-claude-04",
      "title": "The contract is left contradicting the implementation, with the resolution recorded only in a source comment",
      "severity": "high"
    },
    {
      "id": "4bb0a62ae8e0e184::AUDIT-BARRAGE-codex-01",
      "title": "Translate/summarize discard the selected corpus filename policy",
      "severity": "high"
    },
    {
      "id": "5f7ec7a45c763abc::AUDIT-BARRAGE-claude-01",
      "title": "The characterization gate is enumerated, not exhaustive — the T024 regression class can recur for any id not in the hardcoded list",
      "severity": "high"
    },
    {
      "id": "608d3982f7e71600::AUDIT-BARRAGE-claude-01",
      "title": "`CORPUS_SOURCES` is accepted verbatim for *any* selected corpus — a stale env var silently builds one corpus's site from another corpus's source ids",
      "severity": "high"
    },
    {
      "id": "608d3982f7e71600::AUDIT-BARRAGE-claude-02",
      "title": "`CORPUS_SOURCES` alone no longer produces a build — yet the docblocks claim \"unchanged operator-visible behavior\" twice",
      "severity": "high"
    },
    {
      "id": "6b34ca219049bf45::AUDIT-BARRAGE-claude-01",
      "title": "Cased source-group MEMBERS are precomputed into `derived`, giving the same object class two different layout-resolution paths depending on an optional field",
      "severity": "high"
    },
    {
      "id": "750211fe3a39e6b7::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-claude-02+AUDIT-BARRAGE-codex-01",
      "title": "Ambient `committedSourceFilenamePolicy()` re-closes the seam T023 just opened — production paths resolve the corpora root implicitly while `sourcesDir` stays injected",
      "severity": "high"
    },
    {
      "id": "a449de0cfb48f2d5::AUDIT-BARRAGE-claude-01",
      "title": "FR-016 proof tests reference a fixture root (`tests/fixtures/corpora/an-arbitrary-place/`) that does not appear anywhere in the change",
      "severity": "high"
    },
    {
      "id": "a449de0cfb48f2d5::AUDIT-BARRAGE-codex-01",
      "title": "Manifest IDs Can Escape The Corpora Root",
      "severity": "high"
    },
    {
      "id": "a7e5f4849e495cc5::AUDIT-BARRAGE-claude-01",
      "title": "Slug truncation can drop the distinguishing tail of two long titles, silently filing two Sources into one archive directory",
      "severity": "high"
    },
    {
      "id": "a7e5f4849e495cc5::AUDIT-BARRAGE-claude-02",
      "title": "`realResolve` collapses `..` lexically before consulting the filesystem, so a `../` escape through a symlink passes the non-overridable guard",
      "severity": "high"
    },
    {
      "id": "b4b882f97371e813::AUDIT-BARRAGE-claude-01",
      "title": "Retiring `SOURCE_LAYOUTS` makes a missing `archiveLayoutOverrides` entry degrade into a silently-derived wrong archive path instead of a throw",
      "severity": "high"
    },
    {
      "id": "b5fdf705e6ddde59::AUDIT-BARRAGE-claude-01",
      "title": "`installArchiveLayoutPolicy` swaps the policy but never clears the runtime overlay, so stale layouts outrank the newly-installed corpus",
      "severity": "high"
    },
    {
      "id": "e4aa8b5207999e81::AUDIT-BARRAGE-claude-01",
      "title": "The one seam with a module-global fallback is the one seam never proven through the shipped composition path",
      "severity": "high"
    }
  ],
  "closedInLoopFindings": [],
